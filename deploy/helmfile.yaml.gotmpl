# Platform controllers, TLS issuer, operator and Tadoss instance as one dependency graph.
# Environments are the files in deploy/environments; a leading underscore marks a template.
# Values in an environment file merge over values/defaults.yaml.
environments:
  default:
    values: [values/defaults.yaml]
{{- range $file := readDir "environments" }}
{{- $name := $file | base | trimSuffix ".yaml" }}
{{- if and (hasSuffix ".yaml" $file) (not (hasPrefix "_" $name)) }}
  {{ $name }}:
    values: [values/defaults.yaml, environments/{{ $file | base }}]
{{- end }}
{{- end }}
---
{{- $v := .Values }}
{{- $tls := $v.tls }}
{{- $issuer := $tls.issuerName | default (printf "tadoss-%s" ($tls.mode | lower)) }}
{{- if and (ne $tls.mode "existing") (not $v.platform.certManager.enabled) }}
{{-   fail (printf "tls.mode=%s needs cert-manager: enable platform.certManager, or use tls.mode=existing with your own ClusterIssuer" $tls.mode) }}
{{- end }}

{{/* Tadoss spec: merged values plus the API image and a default issuer, applied as one patch. */}}
{{- $spec := deepCopy $v.instance.spec }}
{{- $_ := set $spec "image" (printf "%s:%s" $v.images.api $v.images.tag) }}
{{- if and (ne $tls.mode "existing") (hasKey $spec "ingress") (not (index $spec.ingress "clusterIssuer")) }}
{{-   $_ := set $spec.ingress "clusterIssuer" $issuer }}
{{- end }}

{{/* needs lists only reference releases that are rendered. */}}
{{- $issuerNeeds := list }}
{{- if $v.platform.certManager.enabled }}{{ $issuerNeeds = append $issuerNeeds "cert-manager/cert-manager" }}{{ end }}
{{- if $v.platform.traefik.enabled }}{{ $issuerNeeds = append $issuerNeeds "traefik/traefik" }}{{ end }}
{{- $operatorNeeds := list }}
{{- if $v.platform.cnpg.enabled }}{{ $operatorNeeds = append $operatorNeeds "cnpg-system/cnpg" }}{{ end }}
{{- $instanceNeeds := list (printf "%s/tadoss-operator" $v.operator.namespace) }}
{{- if ne $tls.mode "existing" }}{{ $instanceNeeds = append $instanceNeeds "cert-manager/tadoss-issuer" }}{{ end }}
{{- if $v.platform.traefik.enabled }}{{ $instanceNeeds = append $instanceNeeds "traefik/traefik" }}{{ end }}

repositories:
  - name: cloudnative-pg
    url: https://cloudnative-pg.github.io/charts
  - name: traefik
    url: https://traefik.github.io/charts
  - name: jetstack
    url: https://charts.jetstack.io

helmDefaults:
  createNamespace: true
  wait: true
  waitForJobs: true
  timeout: {{ $v.platform.timeoutSeconds }}
  syncArgs: [--server-side=true]
  diffArgs: [--server-side=true]

releases:
{{- if $v.platform.cnpg.enabled }}
  - name: cnpg
    namespace: cnpg-system
    chart: cloudnative-pg/cloudnative-pg
    version: 0.28.2
    values:
      - {{ toYaml $v.platform.cnpg.values | nindent 8 }}
{{- end }}
{{- if $v.platform.traefik.enabled }}
  - name: traefik
    namespace: traefik
    chart: traefik/traefik
    version: 40.2.0
    values:
      - {{ toYaml $v.platform.traefik.values | nindent 8 }}
{{- end }}
{{- if $v.platform.certManager.enabled }}
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.20.2
    values:
      - {{ toYaml $v.platform.certManager.values | nindent 8 }}
{{- end }}
{{- if ne $tls.mode "existing" }}
  # Released into cert-manager's namespace, where it reads ACME account Secrets.
  - name: tadoss-issuer
    namespace: cert-manager
    chart: ./charts/tadoss-issuer
    {{- with $issuerNeeds }}
    needs: {{ toYaml . | nindent 6 }}
    {{- end }}
    values:
      - name: {{ $issuer }}
        mode: {{ $tls.mode }}
        acme: {{ toYaml $tls.acme | nindent 10 }}
{{- end }}
  - name: tadoss-operator
    namespace: {{ $v.operator.namespace }}
    chart: ./charts/tadoss-operator
    {{- with $operatorNeeds }}
    needs: {{ toYaml . | nindent 6 }}
    {{- end }}
    values:
      - image:
          repository: {{ $v.images.operator }}
          tag: {{ $v.images.tag | quote }}
      - {{ toYaml $v.operator.values | nindent 8 }}
{{- if $v.instance.enabled }}
  # The kustomize base rendered through helmfile. The release namespace replaces the base's
  # namespace and /spec is replaced wholesale from values. Readiness is checked by `task env:wait`.
  - name: tadoss
    namespace: {{ $v.instance.namespace }}
    chart: ./instances/base
    wait: false
    needs: {{ toYaml $instanceNeeds | nindent 6 }}
    jsonPatches:
      - target:
          group: tadoss.livewyer.io
          version: v1alpha1
          kind: Tadoss
          name: tadoss
        patch:
          - op: add
            path: /spec
            value: {{ toYaml $spec | nindent 14 }}
{{- end }}
